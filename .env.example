# Optional: enables OpenAI-generated interest summaries on the local server.
# Keep the real key in .env or in a terminal environment variable. Never put it in app.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required for deployed policy and event storage. Keep service-role credentials server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required by the official OnTongYouth policy importer.
YOUTH_POLICY_API_KEY=

# Protect a scheduled retention request that deletes anonymous events older than 90 days.
ADMIN_MAINTENANCE_TOKEN=
EVENT_RETENTION_DAYS=90

# Active policies older than this source check window are hidden until reviewed again.
POLICY_STALE_DAYS=180

# Used only by npm run check:deployment. Do not expose secrets in this URL.
BRIDGE_BASE_URL=
